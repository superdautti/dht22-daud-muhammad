import paho.mqtt.client as mqtt

# Filled in for you
OPISKELIJATUNNUS = "2406758"
MQTT_BROKER = "iot.research.hamk.fi"
MQTT_PORT = 1883

TOPIC_LAMPOTILA = f"HAMK/Fo/DHT22/{OPISKELIJATUNNUS}/lampotila"
TOPIC_KOSTEUS = f"HAMK/Fo/DHT22/{OPISKELIJATUNNUS}/kosteus"

MITTAUSVALI_SEKUNTIA = 10

# Check which GPIO pin your DHT-22 is wired to on FoCar
DHT_PINNI = 4


